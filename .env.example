# Public, read-only Supabase credentials (no service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional analytics; left empty for local testing
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional AdSense loader; leave empty until ready to monetize
# Use the complete ca-pub-XXXXXXXXXXXXXXXX value. No banner is enabled by this alone.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
